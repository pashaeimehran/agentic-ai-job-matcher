# Copy to .env for local runs. Placeholders only: never commit real values.
# Every variable is optional in fixture mode; see docs/deployment.md for production.

# --- Mode -----------------------------------------------------------------------------
# fixture: deterministic scripted provider, no paid calls, no key needed.
# live:    OpenAI provider and embeddings (paid). auto: live if OPENAI_API_KEY is set.
APP_MODE=fixture
APP_ENV=development
LOG_LEVEL=INFO

# --- OpenAI (live mode) -------------------------------------------------------------------
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.0
# Optional pricing override (USD per 1M tokens), JSON object keyed by model:
# LLM_PRICING_JSON={"gpt-4o-mini": {"input": 0.15, "output": 0.6, "cached_input": 0.075}}

# --- Embeddings ---------------------------------------------------------------------------
# hash (offline lexical baseline) or openai. Default: hash in fixture mode, openai in live mode.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Agent cost controls --------------------------------------------------------------------
AGENT_PROMPT_VERSION=v2
AGENT_MAX_MODEL_TURNS=8
AGENT_MAX_TOOL_CALLS=12
# Per-run budget checked before every model call; "none" disables a limit.
AGENT_MAX_RUN_TOKENS=60000
AGENT_MAX_RUN_COST_USD=none

# --- LLM response cache (process memory only) ----------------------------------------------
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=3600
LLM_CACHE_MAX_ENTRIES=512
# Bump to invalidate every cached response.
LLM_CACHE_VERSION=v1
LLM_CACHE_OPERATIONS=generate,complete

# --- PostgreSQL + pgvector ------------------------------------------------------------------
# Leave DATABASE_URL unset for in-memory CV storage. Use the same password in both lines.
POSTGRES_PASSWORD=replace_with_local_password
DATABASE_URL=postgresql://careermatch:replace_with_local_password@127.0.0.1:5432/careermatch
DB_INIT_ON_STARTUP=true
COST_LOG_ENABLED=true
CV_ID=synthetic-demo
# JSON file for saved jobs when DATABASE_URL is unset (default: data/private/saved_jobs.json).
# SAVED_JOBS_PATH=data/private/saved_jobs.json

# --- Langfuse tracing (optional) -----------------------------------------------------------
# Set TRACING_ENABLED=true plus both keys to export traces. With the Compose observability
# profile, leave both keys empty: compose.yaml provisions a local project with matching default keys.
# Content capture sends prompts/tool outputs (which can contain CV text) to Langfuse:
# keep it false unless Langfuse is self-hosted and trusted.
TRACING_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_CAPTURE_CONTENT=false
